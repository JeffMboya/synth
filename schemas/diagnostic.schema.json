{
  "$defs": {
    "Candidate": {
      "description": "A candidate value the diagnostic suggests instead of what was found.\nDistinct from a [`Patch`] in that candidates are *informational* —\nthey describe possibilities, not edits.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "component",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "component": {
              "type": "string"
            },
            "kind": {
              "const": "pin",
              "type": "string"
            },
            "pin": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "component",
            "pin"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "net",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "constraint",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "module",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "confidence": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "confidence"
      ],
      "type": "object"
    },
    "EntityRef": {
      "description": "A reference to a domain entity (component, pin, net, ...) that the\ndiagnostic concerns. Tagged on `kind` for forward compatibility.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "component",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "component": {
              "type": "string"
            },
            "kind": {
              "const": "pin",
              "type": "string"
            },
            "pin": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "component",
            "pin"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "net",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "constraint",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "module",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "Location": {
      "description": "A fully-qualified location: file path + byte span + derived line/cols.",
      "properties": {
        "byte_end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "byte_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "col_end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "col_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "type": "string"
        },
        "line_end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "byte_start",
        "byte_end",
        "line_start",
        "col_start",
        "line_end",
        "col_end"
      ],
      "type": "object"
    },
    "Patch": {
      "description": "A machine-applicable patch primitive.\n\nEvery diagnostic carries zero or more `Patch` entries in its\n`suggested_fixes`. Patches are total functions: applying a `Patch` to\nthe original source bytes either produces new bytes or returns\n`PatchError::Conflict`. They never panic.\n\nPatch primitives are tagged on `kind` for forward compatibility; new\nvariants are added in minor schema bumps.",
      "oneOf": [
        {
          "description": "Replace the bytes in `range` with `replacement`.",
          "properties": {
            "kind": {
              "const": "replace_range",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/Span"
            },
            "replacement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "range",
            "replacement"
          ],
          "type": "object"
        },
        {
          "description": "Insert `text` at the byte offset `at`.",
          "properties": {
            "at": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "insert_at",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Delete the bytes in `range`.",
          "properties": {
            "kind": {
              "const": "delete_range",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/Span"
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "description": "Insert a new statement (semantic, not textual) at the\nappropriate scope. The host re-renders the source.",
          "properties": {
            "kind": {
              "const": "add_statement",
              "type": "string"
            },
            "scope": {
              "description": "Identifier of the enclosing scope (e.g., a board name or module\nname). Empty string means the top-level scope.",
              "type": "string"
            },
            "statement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "scope",
            "statement"
          ],
          "type": "object"
        },
        {
          "description": "Remove a statement identified by `id`.",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "remove_statement",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Quantitative numeric update solved via SMT solver.",
          "properties": {
            "constraint": {
              "type": "string"
            },
            "kind": {
              "const": "solve_smt",
              "type": "string"
            },
            "replacement_template": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_range": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Span"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "constraint"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "confidence": {
          "description": "Confidence score in `[0.0, 1.0]`. Agents typically apply the\nhighest-confidence patch first.",
          "format": "float",
          "type": "number"
        },
        "patch_consequence_preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatchConsequencePreview"
            },
            {
              "type": "null"
            }
          ],
          "description": "Predicted downstream diagnostic consequences of applying this patch."
        },
        "rationale": {
          "description": "Free-form human-readable rationale. Optional; agents may ignore.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "confidence"
      ],
      "type": "object"
    },
    "PatchConsequencePreview": {
      "description": "Predicted diagnostic consequences resulting from applying a patch.",
      "properties": {
        "model_confidence": {
          "default": 0.0,
          "description": "Model confidence in `[0.0, 1.0]`.",
          "format": "float",
          "type": "number"
        },
        "predicted_new_diagnostics": {
          "description": "Expected new diagnostic codes that may be introduced downstream.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "predicted_resolved_diagnostics": {
          "description": "Expected diagnostic codes that will be resolved by the patch.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    },
    "Span": {
      "description": "Half-open byte range `[start, end)` within a single source file.\n\nAlways carry the file id alongside (see [`Location`]); a `Span` alone is\nonly meaningful inside the parser's per-file context.",
      "properties": {
        "byte_end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "byte_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "byte_start",
        "byte_end"
      ],
      "type": "object"
    },
    "SuggestedAction": {
      "description": "A non-textual next step the agent can take to resolve the diagnostic —\ndistinct from a [`Patch`] in that it does not edit the source file's\nbytes. Applying one means calling the named MCP tool (or CLI\nequivalent) with the given arguments, not patching `board.synth`.\n\nIntroduced for `E-SYNTH-COMP-001` (Phase 15, §18.8.4): an unknown\npart cannot be fixed by rewriting the reference alone — the agent\nmust first grow the registry via search/import/authoring, then\nrevalidate.",
      "oneOf": [
        {
          "description": "Search LCSC/EasyEDA for a part matching `query` via the\n`synth_search_registry_web` MCP tool / `synth part search` CLI.",
          "properties": {
            "kind": {
              "const": "search_registry_web",
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "query"
          ],
          "type": "object"
        },
        {
          "description": "Import a part into the Tier-2 registry via the `synth_import_part`\nMCP tool / `synth part import lcsc|kicad` CLI, once a search (or\nthe user) has identified a source id for `part_id`.",
          "properties": {
            "kind": {
              "const": "import_part_stub",
              "type": "string"
            },
            "part_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "part_id"
          ],
          "type": "object"
        },
        {
          "description": "Write a required-pins-relaxed TOML skeleton for `part_id` into\nthe Tier-2 registry via `synth part stub` / `create_part_stub`,\nthen fill it in from a datasheet and revalidate.",
          "properties": {
            "kind": {
              "const": "create_part_stub",
              "type": "string"
            },
            "part_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "part_id"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The top-level diagnostic record. Stable wire format; see\n[`crate::SCHEMA_VERSION`].",
  "properties": {
    "candidates": {
      "description": "Informational candidates (not edits — see `suggested_fixes` for\nedits).",
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "type": "array"
    },
    "code": {
      "description": "Stable diagnostic code, e.g. `E-SYNTH-PARSE-001`. Codes are\ndocumented one-per-file under `docs/diagnostics/`.",
      "type": "string"
    },
    "entities": {
      "description": "Domain entities the diagnostic concerns (legacy flat list).\nKept for backward compatibility; prefer primary_entity/peer_entities.",
      "items": {
        "$ref": "#/$defs/EntityRef"
      },
      "type": "array"
    },
    "expected": {
      "description": "What the rule expected to find. Free-form description.",
      "type": [
        "string",
        "null"
      ]
    },
    "explanation_url": {
      "description": "URL to the documentation page for this diagnostic code.\nConvention: `synth.docs/diagnostics/<code>`.",
      "type": [
        "string",
        "null"
      ]
    },
    "found": {
      "description": "What was found instead. Free-form description.",
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source location the diagnostic is anchored to. Required for all\nnon-internal diagnostics."
    },
    "message": {
      "description": "Optional longer human-readable message. May contain interpolated\nvalues; not stable across patch releases.",
      "type": [
        "string",
        "null"
      ]
    },
    "peer_entities": {
      "description": "Related entities for cross-reference (e.g., conflicting pins).",
      "items": {
        "$ref": "#/$defs/EntityRef"
      },
      "type": "array"
    },
    "primary_entity": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Primary entity the diagnostic is about (for click-to-navigate)."
    },
    "schema_version": {
      "description": "Schema version this diagnostic conforms to. Always written by\nbuilders; consumers may pin to a major version.",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "smt_constraint": {
      "description": "Optional SMT-LIB2 constraint payload for quantitative diagnostics.",
      "type": [
        "string",
        "null"
      ]
    },
    "suggested_actions": {
      "description": "Non-textual next steps (tool calls, not source edits) — see\n[`SuggestedAction`].",
      "items": {
        "$ref": "#/$defs/SuggestedAction"
      },
      "type": "array"
    },
    "suggested_fixes": {
      "description": "Machine-applicable patches, ordered by descending confidence.\nAlways at least one entry for rules that have a known fix.",
      "items": {
        "$ref": "#/$defs/Patch"
      },
      "type": "array"
    },
    "title": {
      "description": "Short human-readable title. Stable across patch releases of the\nemitting rule; do not parse.",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "code",
    "severity",
    "title"
  ],
  "title": "Diagnostic",
  "type": "object"
}
