// Same as pass__impedance_pair_width_gap_ok, but the negative leg is in no class: only one leg declares geometry.
board "pair_half_declared" {
  layers 2

  netclass "USB" {
    trace_width 0.242mm
    clearance 0.127mm
  }

  component R1: resistor "r_generic_0603" value "10k"
  component R2: resistor "r_generic_0603" value "10k"
  component R3: resistor "r_generic_0603" value "10k"
  component R4: resistor "r_generic_0603" value "10k"

  connect R1.p1 -> R2.p1 as "USB_DP" class "USB"
  connect R3.p1 -> R4.p1 as "USB_DN"

  diff_pair USB_DP USB_DN {
    impedance 90ohm
  }

  stackup {
    copper 0.035mm
    insulator 0.2104mm er 4.4
    copper 0.035mm
  }
}
