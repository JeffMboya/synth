// Same as pass__impedance_width_ok on a four-layer stackup: the net may be routed on an inner layer, where impedance is not verified.
board "inner_layers" {
  layers 4

  netclass "RF" {
    trace_width 0.35mm
  }

  component U1: antenna "ant_chip_2g4"
  component R1: resistor "r_generic_0603" value "10k"

  connect U1.feed -> R1.p1 as "RF_IN" class "RF"

  diff_pair u1_feed r1_p1 {
    impedance 50ohm
  }

  keepout antenna {
    radius 10mm
  }

  stackup {
    copper 0.035mm
    insulator 0.2104mm er 4.4 material "FR4"
    copper 0.0152mm
    insulator 1.065mm er 4.6 material "FR4"
    copper 0.0152mm
    insulator 0.2104mm er 4.4 material "FR4"
    copper 0.035mm
  }
}
