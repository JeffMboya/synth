board "stackup_unsupported_layer_count" {
  layers 8

  component R1: resistor "r_generic_0603" value "10k"
  component R2: resistor "r_generic_0603" value "10k"

  connect R1.p1 -> R2.p1
  connect R1.p2 -> R2.p2

  stackup {
    copper 0.035mm
    insulator 0.1mm er 4.4
    copper 0.0152mm
    insulator 0.1mm er 4.4
    copper 0.0152mm
    insulator 0.1mm er 4.4
    copper 0.0152mm
    insulator 0.1mm er 4.4
    copper 0.0152mm
    insulator 0.1mm er 4.4
    copper 0.0152mm
    insulator 0.1mm er 4.4
    copper 0.0152mm
    insulator 0.1mm er 4.4
    copper 0.035mm
  }
}
