// Same as pass__impedance_pair_width_gap_ok with a 0.17 mm width: about 105 ohm, 10 to 20 percent off 90 ohm.
board "pair_width_warning" {
  layers 2

  netclass "USB" {
    trace_width 0.17mm
    clearance 0.127mm
  }

  component R1: resistor "r_generic_0603" value "10k"
  component R2: resistor "r_generic_0603" value "10k"
  component R3: resistor "r_generic_0603" value "10k"
  component R4: resistor "r_generic_0603" value "10k"

  connect R1.p1 -> R2.p1 as "USB_DP" class "USB"
  connect R3.p1 -> R4.p1 as "USB_DN" class "USB"

  diff_pair USB_DP USB_DN {
    impedance 90ohm
  }

  stackup {
    copper 0.035mm
    insulator 0.2104mm er 4.4
    copper 0.035mm
  }
}
