			(justify left bottom)
		)
		(uuid "30de5894-af8e-5a5b-a7d9-66682d59252d")
	)
	(text
		"J1 pin 1 is +24 V, pin 2 is GND."
		(at 17.28 103.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ff29844b-4c56-523e-837f-c6919226717a")
	)
	(text
		"F1 resettable PTC: Ihold 1.1 A, Vmax 33 V."
		(at 17.28 106.09 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "86ee2b38-0f89-5d71-8265-7733575fc48d")
	)
	(text
		"D1 Schottky in series blocks reverse polarity."
		(at 17.28 108.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "98f76993-7eac-5c01-ad86-1802896c9b99")
	)
	(text
		"D2 TVS (26 V standoff) sits after D1, directly on the VIN node. It clamps surge energy only."
		(at 17.28 111.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "5536511a-f71e-5d5f-a602-0c99ba4a238a")
	)
	(text
		""
		(at 18.62 224.68 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "225d9a56-42be-540c-ac17-014970b774fc")
	)
	(text
		"C1 bulk, C2 ceramic (datasheet: over 10 uF), C3 high-frequency next to the VIN pin."
		(at 18.62 228.68 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8bdec558-35d9-53b4-8ad2-21181e87c6c7")
	)
	(text
		"50 V parts for a 24 V rail; DC-bias derating not known, effective C2 may be under 10 uF."
		(at 18.62 231.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c7d75b5c-e0bc-5916-aa00-a0d3d3e01b2d")
	)
	(text
		""
		(at 266.2 74.82 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9c80f222-ab2b-5199-93a7-6dcbd8149556")
	)
	(text
		"EN divider from VIN. Datasheet Eq 1 and 2 give start 18.31 V, stop 15.67 V (typical thresholds)."
		(at 266.2 78.82 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "344fdc62-699e-5e4c-9a99-66b1b4b07b15")
	)
	(text
		"With 1% resistors: start 17.96-18.67 V, stop 15.35-15.99 V."
		(at 266.2 81.36 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8b0d0a4a-27c1-5d9b-ba5e-0bb3f98c31fa")
	)
	(text
		"EN stays under 1.75 V at a 28 V input (EN limit 5.5 V)."
		(at 266.2 83.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "981bdcdd-5ab9-57af-ba3a-300b5ec06278")
	)
	(text
		""
		(at 266.3 206.9 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f863e118-b48c-5d1f-a345-322310b5e295")
	)
	(text
		"TPS54202: 500 kHz, internal compensation, no power-good pin."
		(at 266.3 210.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "6b4c2830-9063-574b-b67e-0a143a352468")
	)
	(text
		"C4 100 nF boot capacitor between BOOT and SW."
		(at 266.3 213.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f6021842-12fd-527a-97bb-a4256f68d81a")
	)
	(text
		"L1 10 uH and 2x 22 uF follow datasheet Table 7-2 for 3.3 V (44 uF)."
		(at 266.3 215.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "25239301-26fd-5f7e-be6f-3596bd9f4a52")
	)
	(text
		"C5/C6 are 25 V X7R; DC-bias derating unknown. fo = 3.95/(Vout x COUT) must stay under 40 kHz."
		(at 266.3 218.52 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3ccc40ff-ccf4-5c3c-b804-e61c67200dec")
	)
	(text
		""
		(at 165.94 97.68 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3b8ff183-6c0b-5989-9b40-de3d2f7b6f2d")
	)
	(text
