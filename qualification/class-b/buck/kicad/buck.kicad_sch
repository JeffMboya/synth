	)
	(text
		"MECHANICAL"
		(at 348.5092 15.81 0)
		(effects
			(font
				(size 2.54 2.54)
				bold
			)
			(justify left bottom)
		)
		(uuid "bf359efe-451f-5491-ab50-ca28b08566c6")
	)
	(text
		""
		(at 17.28 46.88 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "49440ab3-5e44-5a53-8510-c9cd7c608393")
	)
	(text
		"J1 pin 1 is +24 V, pin 2 is GND."
		(at 17.28 50.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "36dc3697-f160-5657-9ee0-08802d56734b")
	)
	(text
		"F1 resettable PTC: Ihold 1.1 A, Vmax 33 V."
		(at 17.28 53.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "52136f32-4550-513f-8f5b-ce2760da10f3")
	)
	(text
		"D1 Schottky in series blocks reverse polarity."
		(at 17.28 55.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4ba61855-8b55-58f3-883e-4b1248a9ea11")
	)
	(text
		"D2 TVS (30 V standoff) sits after D1, directly on the VIN node. It clamps ESD and transient energy only; the clamp is above U1's absolute maximum, so it is not an OVP."
		(at 17.28 58.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "243c96b5-30d9-5a9f-8d5e-6e69027d6614")
	)
	(text
		""
		(at 18.55 133.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7c897688-bb42-5f34-a43b-51ec1878dec2")
	)
	(text
		"C1 bulk, C2 ceramic, C3 high-frequency next to the VIN pin (LMR33640 Table 9-2: 10 uF + 220 nF)."
		(at 18.55 137.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d57eeb46-d2d2-5ad0-83cd-b8c51c0efa17")
	)
	(text
		"50 V parts for a 24 V rail; DC-bias derating of C2 is not known."
		(at 18.55 139.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "033c229a-975e-534f-a19e-697ae802cdfd")
	)
	(text
		""
		(at 153.24 133.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "67d09a96-3729-5a21-a544-facb3b94c530")
	)
	(text
		"EN divider from VIN. LMR33640 VEN-H 1.231 V typical, 100 mV hysteresis: start 18.1 V, stop 16.6 V."
		(at 153.24 137.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f0f14f9f-c6a6-532d-ae34-189d160c324b")
	)
	(text
		"EN stays under 2 V at a 28 V input (EN absolute maximum is VIN + 0.3 V)."
		(at 153.24 139.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4668f52c-a8b3-5a2b-b456-cfe4776d01d2")
	)
	(text
		""
		(at 17.38 205.63 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "69e2ba63-8a95-5624-a567-166f7aa1e5aa")
	)
	(text
		"LMR33640: 400 kHz, internal compensation, exposed pad (pin 9) on GND, open-drain PG."
		(at 17.38 209.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "de232a33-a444-56ba-a973-b8dc6c75c40c")
	)
	(text
		"C4 100 nF boot capacitor between BOOT and SW; C8 1 uF on VCC."
		(at 17.38 212.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8a054eeb-d9fb-5d71-a0ce-4e728c2866b6")
	)
	(text
		"L1 6.8 uH and 3x 22 uF follow Table 9-2 for 3.3 V at 400 kHz (minimum Cout is 3x 22 uF)."
		(at 17.38 214.71 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "6a4ffd2a-578d-5f83-8d80-8ac46fd254f4")
	)
	(text
		"The exposed pad (pin 9) is soldered to the F.Cu GND pour. There are no vias in the pad:"
		(at 17.38 217.25 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2b3067f7-ff76-5efa-be29-0360189f341d")
	)
	(text
		"the board's fabrication floor is a 0.3 mm drill and the KiCad thermal-via footprint ships 0.2 mm."
		(at 17.38 219.79 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "311279d4-d00d-526c-8f91-adc2f5f3aa8b")
	)
	(text
		""
		(at 281.83 130.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "84b81086-fe99-52a7-b2b3-be9c47614aee")
	)
	(text
		"Vout = 1.0 V x (1 + 100k / 43.2k) = 3.31 V."
		(at 281.83 134.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8614aa7d-0e48-5d8b-8a5b-82457316c357")
	)
	(text
		"Divider taps the output node on the far side of L1, not SW."
		(at 281.83 137.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "92463cc1-0a73-5a50-9f5e-119c6f7a84d3")
	)
	(text
		"C7 56 pF feed-forward across the upper resistor (datasheet Eq 9 gives about 60 pF)."
		(at 281.83 139.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "69486300-6bc4-52d0-ae27-98eccee8dfcc")
	)
	(text
		""
		(at 196.45 57.04 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e6a01d2f-dc52-539f-bc82-866e57ed919a")
	)
	(text
		"PG is open drain and pulled up to +3V3 through 100k (datasheet 8.3.1 suggests 100k to VCC or VOUT)."
		(at 196.45 61.04 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "5f63ecf2-b0cf-56e1-9736-6ef2354b3c86")
	)
	(text
		"PG goes low during start-up and on a fault, so J2 pin 3 reads valid only after the 4 ms start-up delay."
		(at 196.45 63.58 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ab52d44f-c3be-5dbf-8263-df1ec5815da9")
	)
	(text
		"D4 green fault LED from +3V3 through R_PGLED to PG: it is lit while PG is low, dark while power is good."
		(at 196.45 66.12 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4d3d9a9d-f4f1-505c-b7dd-4b0dcb164e0c")
	)
	(text
		"About 2.5 mA when lit (470 R, Vf about 2.1 V); U1's PG pull-down is 76 to 150 ohm RDSON, so PG stays near 0.4 V."
		(at 196.45 68.66 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "82945153-c6bc-5fbe-be52-e7666bd5af63")
	)
	(text
		""
		(at 314.7 209.44 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c8cc8e65-4ce1-571c-accf-90b67c05a413")
	)
	(text
		"J2 pin 1 is +3.3 V, pin 2 GND, pin 3 power-good (3.3 V logic, 100k pull-up), pin 4 GND."
		(at 314.7 213.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "822f3094-8d19-5c79-b11d-2fbb8b0b042a")
	)
	(text
		"D3 green power LED from the 3.3 V rail."
		(at 314.7 215.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "155cadbc-09f5-5bb4-8db0-e7b25d9113b2")
	)
	(text
		""
		(at 319.96 43.07 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "42bdc38c-1cce-5771-bfb2-b1e4e36f38f4")
	)
	(text
		"Two M2.5 non-plated holes in opposite corners; the board is fixed down through them."
		(at 319.96 47.07 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f66b7d6f-ce2b-5fa3-9987-1308bfee157f")
	)
