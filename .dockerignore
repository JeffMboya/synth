# Docker images build the CLI in a compatible Debian builder. Keep host build
# artifacts out of the context while allowing the source and registry through.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!rustfmt.toml
!deny.toml
!crates/
!crates/**
!examples/
!examples/**
!registry/
!registry/**

# Renderer adapters are copied into the production KiCad image.
!tools/
!tools/freeroute_autoroute.py
!tools/import_freerouting_ses_text.py
!tools/kicad_routing_tools_route.py
